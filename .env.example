# ========================================================
# SAFECODIUM / SAFE VIBE AI — ENVIRONMENT CONFIGURATION
# ========================================================

# Application Core
ENVIRONMENT=development
# DEBUG can be True/False, 1/0, or left blank in production
DEBUG=True
PORT=8000
HOST=127.0.0.1
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Database
DATABASE_URL=sqlite+aiosqlite:///./safevibe.db

# Storage Paths
UPLOAD_DIR=./data/uploads
WORKSPACE_DIR=./data/workspaces
ARTIFACT_DIR=./data/artifacts

# AI Engine Configuration
# Primary: Google Gemini API (Recommended for live reasoning & synthesis)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Secondary: OpenAI API (Optional critique provider)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Local / Offline: Ollama (Optional offline mode)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# Provider Selection: gemini | openai | ollama
DEFAULT_AI_PROVIDER=gemini
